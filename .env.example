# Copia este archivo a .env y completa los valores para probar
# el inicio de sesión con Google en tu máquina local.
#
# Consíguelos en https://console.cloud.google.com/apis/credentials
# (crea un "OAuth client ID" tipo "Web application" y agrega
# http://localhost:3000/api/auth/google/callback como
# "Authorized redirect URI").

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Soporte con asistente autónomo ----
#
# Sin ninguna clave el soporte SIGUE funcionando: busca en la base de
# conocimiento, guía en pantalla y abre tickets. Lo que no hace es
# conversar. Pon la clave del proveedor que uses y se elige solo.

OPENAI_API_KEY=

# El modelo tiene que existir en tu cuenta. Si la API rechaza la petición,
# el servidor lo dice en el registro y el soporte sigue en modo ayuda.
# OPENAI_MODEL=gpt-4o-mini

# Para usar otro proveedor que hable el mismo formato que OpenAI (Groq,
# Together, Mistral, OpenRouter, DeepSeek, Ollama...): su URL y su clave en
# OPENAI_API_KEY. No hace falta tocar código.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Sólo para modelos que razonan (los demás rechazan el campo).
# OPENAI_REASONING_EFFORT=low

# ---- Otros proveedores ----
#
# Claude. Si pones esta clave y no OPENAI_API_KEY, se usa este.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low

# Forzar uno concreto: openai | anthropic | local. Sin esto se elige por la
# clave que haya. Hay un archivo por proveedor en support/ai/proveedores/;
# ese index.js explica el contrato para añadir otro.
# SUPPORT_AI_PROVIDER=openai

# Reintento en otro modelo cuando Claude declina por política (sólo Claude).
# SUPPORT_FALLBACKS=on

# ---- Topes del asistente ----
#
# Pensados para el tráfico real de esta plataforma; súbelos sólo si el panel
# dice que se agotan.
# SUPPORT_DAILY_CALLS=400
# SUPPORT_DAILY_TOKENS=600000

# Mensajes de chat por IP cada 5 minutos. Doce bastan para una conversación
# real; súbelo sólo si tienes mucha gente saliendo por la misma IP (una
# oficina, una universidad) y se quejan de que les corta.
# SUPPORT_CHAT_PER_IP=12

# Quién ve el buzón de tickets. Misma lista que ya usa la insignia de dueño.
# OWNER_USERNAMES=tu-usuario
