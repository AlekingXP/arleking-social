# Copia este archivo a .env y completa los valores para probar
# el inicio de sesión con Google en tu máquina local.
#
# Consíguelos en https://console.cloud.google.com/apis/credentials
# (crea un "OAuth client ID" tipo "Web application" y agrega
# http://localhost:3000/api/auth/google/callback como
# "Authorized redirect URI").

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Soporte con asistente autónomo ----
#
# Sin ANTHROPIC_API_KEY el soporte SIGUE funcionando: busca en la base de
# conocimiento y abre tickets. Lo que no hace es conversar. Añádela para
# encender el asistente.
ANTHROPIC_API_KEY=

# Opcionales. Los valores por defecto están pensados para el tráfico real
# de esta plataforma; súbelos sólo si el panel dice que se agota.
# SUPPORT_MODEL=claude-opus-5
# SUPPORT_EFFORT=low
# SUPPORT_DAILY_CALLS=400
# SUPPORT_DAILY_TOKENS=600000

# Qué proveedor de IA atiende el chat. Hay uno por archivo en
# support/ai/proveedores/; ese index.js explica el contrato para añadir otro.
# Con "local" (o sin clave) el soporte sigue funcionando: busca en la ayuda,
# guía en pantalla y abre tickets, pero no conversa.
# SUPPORT_AI_PROVIDER=anthropic

# Reintento en otro modelo cuando Claude declina una petición por política.
# Viene activado; ponlo en "off" si tu cuenta no admite ese parámetro (si la
# API lo rechaza, el servidor lo desactiva solo y lo avisa en el registro).
# SUPPORT_FALLBACKS=on

# Quién ve el buzón de tickets. Misma lista que ya usa la insignia de dueño.
# OWNER_USERNAMES=tu-usuario
